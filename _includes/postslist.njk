<ol reversed class="list-group list-group-numbered list-group-flush">
{%- for post in postslist | reverse %}
	<li class="list-group-item d-flex justify-content-between align-items-center gap-3{% if post.url == url %} active{% endif %}">
		<a href="{{ post.url }}" class="flex-grow-1 fw-bold text-decoration-none">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
		<time class="text-body-secondary small" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("LLLL yyyy") }}</time>
	</li>
{%- endfor %}
</ol>
