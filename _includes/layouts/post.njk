---
layout: layouts/base.njk
---
{# Only include the syntax highlighter CSS on blog posts, included with the CSS per-page bundle #}
<style>{% include "node_modules/prismjs/themes/prism-okaidia.css" %}</style>
<style>{% include "css/prism-diff.css" %}</style>
<style>{% include "css/prism-typst.css" %}</style>
<link rel="stylesheet" href="/css/katex.min.css">

<div class="row">
	<div class="col">
		<h1 id="post-title">{{ title }}</h1>
	</div>
	<div class="col-auto d-none d-md-flex">
		{% include "author.njk" %}
	</div>
</div>

<div class="row mb-1">
	<div class="col d-flex align-items-center">
		<span class="text-body-secondary my-1">
			{%- set date = page.date %}
			{% include "post-date.njk" %}
		</span>
	</div>
	<div class="col-auto d-flex d-md-none">
		{% include "author.njk" %}
	</div>
</div>

{%- set postTags = tags | filterTagList %}
{% if postTags|length %}
	<ul class="list-inline text-body-secondary">
		{%- for tag in postTags %}
		{%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
		<li class="list-inline-item"><a href="{{ tagUrl }}" class="badge text-muted bg-primary-subtle border border-primary text-decoration-none text-capitalize fst-italic">{{ tag }}</a></li>
		{%- endfor %}
	</ul>
{% endif %}

<hr class="mt-2">

<div class="post-content">
	{{ content | safe }}
</div>

{%- if collections.posts %}
{%- set previousPost = collections.posts | getPreviousCollectionItem %}
{%- set nextPost = collections.posts | getNextCollectionItem %}
{%- if nextPost or previousPost %}
<nav class="d-flex justify-content-between gap-3 border-top mt-4 pt-3">
	<div>
		{%- if previousPost %}← Previous<br><a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a>{% endif %}
	</div>
	<div class="text-end">
		{%- if nextPost %}Next →<br><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a>{% endif %}
	</div>
</nav>
{%- endif %}
{%- endif %}

<script>
(() => {
	const heading = document.getElementById("post-title");
	const navTitle = document.getElementById("navbar-scroll-title");
	const navbar = document.querySelector("nav.navbar");
	if (!heading || !navTitle || !navbar) return;
	navTitle.textContent = heading.textContent;
	const navbarHeight = navbar.offsetHeight;
	const observer = new IntersectionObserver(
		([entry]) => {
			const scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < navbarHeight;
			if (scrolledPast) {
				navTitle.classList.add("is-visible", "was-visible");
			} else {
				navTitle.classList.remove("is-visible");
			}
		},
		{ rootMargin: `-${navbarHeight}px 0px 0px 0px` }
	);
	observer.observe(heading);
})();
</script>
