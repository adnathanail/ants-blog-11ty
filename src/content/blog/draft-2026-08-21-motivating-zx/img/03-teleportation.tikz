\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-1, 0.5) {};
		\node [style=none] (1) at (-1, -0.25) {};
		\node [style=none] (2) at (-1, -1) {};
		\node [style=Z dot] (3) at (-0.5, 0.5) {};
		\node [style=X dot] (4) at (-0.5, -0.25) {};
		\node [style=hadamard] (5) at (0.25, 0.5) {};
		\node [style=X phase dot] (6) at (1, 0.5) {$\alpha \pi$};
		\node [style=X phase dot] (7) at (1, -0.25) {$\beta \pi$};
		\node [style=X phase dot] (8) at (0.25, -1) {$\beta \pi$};
		\node [style=Z phase dot] (9) at (1, -1) {$\alpha \pi$};
		\node [style=none] (10) at (1.5, -1) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw (0.center) to (3);
		\draw (3) to (5);
		\draw (5) to (6);
		\draw (3) to (4);
		\draw (4) to (7);
		\draw (4) to (1.center);
		\draw [looseness=1.25, bend left=270] (1.center) to (2.center);
		\draw (2.center) to (8);
		\draw (8) to (9);
		\draw (9) to (10.center);
	\end{pgfonlayer}
\end{tikzpicture}
