<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{{ title or metadata.title }}</title>
		<meta name="description" content="{{ description or metadata.description }}">
		<link rel="alternate" href="rss.xml" type="application/atom+xml" title="{{ metadata.title }}">

		<link rel="icon" href="/img/favicon.ico" sizes="any">
		<link rel="apple-touch-icon" href="/img/apple-touch-icon.png">

		{#- @font-face definitions must be parsed before Bootstrap references the families #}
		<style>{% include "src/assets/scss/fonts.css" %}</style>

		<link href="/css/bootstrap.css" rel="stylesheet">

		{#- Small amount of site-specific CSS on top of Bootstrap #}
		<style>{% include "src/assets/scss/index.css" %}</style>

		{#- Per-page CSS bundle (e.g. Prism themes added by post layouts) #}
		<style>{% getBundle "css" %}</style>

		{#- Add the heading-anchors web component to the JavaScript bundle #}
		<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>
	</head>
	<body class="d-flex flex-column min-vh-100">
		<a href="#main" id="skip-link" class="visually-hidden-focusable">Skip to main content</a>

		<nav class="navbar navbar-expand-md bg-body-tertiary border-bottom sticky-top">
			<div class="container position-relative">
				<div class="navbar-scroll-title-wrap d-flex position-absolute top-50 start-50 translate-middle">
					<a href="#" class="navbar-scroll-title text-body-secondary" id="navbar-scroll-title" aria-label="Scroll to top" data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Scroll to top">
						<i class="bi bi-arrow-90deg-up"></i>
						<span class="navbar-scroll-title-text"></span>
					</a>
				</div>
				<a class="navbar-brand d-flex align-items-center gap-2" href="/">
					<img src="/img/ants.png" alt="" height="32" eleventy:ignore>
					<p class="h5 mb-0">{{ metadata.title }}</p>
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primary-nav" aria-controls="primary-nav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="primary-nav">
					<ul class="navbar-nav ms-auto">
					{%- for entry in collections.all | eleventyNavigation %}
						<li class="nav-item"><a class="nav-link h6 mb-0{% if entry.url == page.url %} active{% endif %}" href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
					{%- endfor %}
					</ul>
				</div>
			</div>
		</nav>

		<main id="main" class="container flex-grow-1 py-4">
			<heading-anchors>
				{{ content | safe }}
			</heading-anchors>
		</main>

		<footer class="border-top mt-4 py-3">
			<div class="container">
				<div class="d-flex flex-column-reverse flex-md-row justify-content-md-between align-items-center gap-2 text-body-secondary">
					<em>&copy; {% currentYear %} Alex Nathanail licensed under <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a></em>
					<ul class="list-inline mb-0 d-flex gap-3">
						<li class="list-inline-item"><a href="https://github.com/adnathanail" aria-label="GitHub" class="text-body-secondary fs-5"><i class="bi bi-github"></i></a></li>
						<li class="list-inline-item"><a href="https://www.linkedin.com/in/adnathanail/" aria-label="LinkedIn" class="text-body-secondary fs-5"><i class="bi bi-linkedin"></i></a></li>
						<li class="list-inline-item"><a href="https://www.instagram.com/alex.doingstuff/" aria-label="Instagram" class="text-body-secondary fs-5"><i class="bi bi-instagram"></i></a></li>
					</ul>
				</div>
			</div>
		</footer>

		<!-- This page `{{ page.url }}` was built on {% currentBuildDate %} -->
		<script src="/js/bootstrap.bundle.min.js"></script>
		<script type="module" src="{% getBundleFileUrl "js" %}"></script>
		<script>
		(() => {
			const heading = document.querySelector("main h1");
			const navTitle = document.getElementById("navbar-scroll-title");
			const navTitleText = navTitle?.querySelector(".navbar-scroll-title-text");
			const navbar = document.querySelector("nav.navbar");
			if (!heading || !navTitle || !navTitleText || !navbar) return;
			navTitleText.textContent = heading.textContent;
			// Scale wipe animation duration with rendered title width so the
			// wipe travels faster for longer titles.
			const setWipeDuration = () => {
				const width = navTitle.getBoundingClientRect().width;
				navTitle.style.setProperty("--wipe-duration", `${Math.sqrt(width) / 25}s`);
			};
			setWipeDuration();
			new ResizeObserver(setWipeDuration).observe(navTitle);
			navTitle.addEventListener("click", (e) => {
				e.preventDefault();
				window.scrollTo({ top: 0, behavior: "smooth" });
			});
			new bootstrap.Tooltip(navTitle);
			const navbarHeight = navbar.offsetHeight;
			const observer = new IntersectionObserver(
				([entry]) => {
					const scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < navbarHeight;
					if (scrolledPast) {
						navTitle.classList.add("is-visible", "was-visible");
					} else {
						navTitle.classList.remove("is-visible");
					}
				},
				{ rootMargin: `-${navbarHeight}px 0px 0px 0px` }
			);
			observer.observe(heading);
		})();
		</script>
	</body>
</html>
