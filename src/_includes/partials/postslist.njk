{% include "partials/deferred_images.njk" %}
<div class="row row-cols-1 row-cols-xl-2 g-3 deferred-img-batch">
	{%- for post in postslist %}
		<div class="col">
			<div class="card h-100">
				<div class="row g-0 h-100">
					<div class="col d-flex flex-column">
						<div class="card-header">
							<a href="{{ post.url }}">
								<h4 class="card-title mb-0" data-ha-exclude>{{ post.data.title }}</h4>
							</a>
						</div>
						<div class="card-body d-flex flex-column justify-content-between">
							<div>
								<p class="card-text text-muted mb-2">{{ post.data.description }}</p>
								{%- set date = post.date %}
								{%- set updatedDate = post.data.updatedDate %}
								{% include "partials/post-date.njk" %}
							</div>
							<div>
								{%- set postTags = post.data.tags | filterTagList %}
								{%- set author = post.data.author %}
								{% include "partials/tags-and-author.njk" %}
							</div>
						</div>
					</div>
					<div class="col-12 col-md-5 col-lg-6 col-xl-3 position-relative placeholder-glow">
						{%- set imgClasses = "blog-post-img-rounding h-100 w-100 mh-30vh" %}
						<span class="placeholder position-absolute top-0 start-0 {{ imgClasses }} deferred-img-placeholder" style="visibility: hidden" aria-hidden="true"></span>
						<a href="{{ post.url }}">
							<img src="{{ post.page.url }}{{ post.data.heroImg }}" class="img-fluid {{ imgClasses }} object-fit-cover deferred-img" alt="...">
						</a>
					</div>
				</div>
			</div>
		</div>
	{%- endfor %}
</div>
