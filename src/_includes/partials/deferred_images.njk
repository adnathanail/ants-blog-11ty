<style>
	@media (scripting: enabled) {
		.deferred-img-placeholder { visibility: visible !important; }
		.deferred-img { visibility: hidden; }
	}
</style>
<script>
document.addEventListener("DOMContentLoaded", () => {
	document.querySelectorAll(".deferred-img-batch").forEach((batch) => {
		const media = batch.querySelectorAll(".deferred-img");
		const waits = Array.from(media).map((el) => {
			const isVideo = el.tagName === "VIDEO";
			const isReady = isVideo ? el.readyState >= 2 /* HAVE_CURRENT_DATA */ : el.complete;
			if (isReady) return Promise.resolve();
			return new Promise((resolve) => {
				el.addEventListener(isVideo ? "loadeddata" : "load", resolve, { once: true });
				el.addEventListener("error", resolve, { once: true });
			});
		});
		Promise.all(waits).then(() => {
			media.forEach((el) => {
				el.style.visibility = "visible";
				el.closest(".placeholder-glow")?.querySelector(".deferred-img-placeholder")?.remove();
			});
		});
	});
});
</script>
