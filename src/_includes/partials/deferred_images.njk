<style>
	/* Two ways to show a placeholder until an image is revealed:
	   - a .deferred-img-placeholder span laid over a hidden .deferred-img
	     (the card layouts, which already have a positioned wrapper);
	   - .deferred-img-glow on the media element itself (blog post images, see
	     post-media.js). Its pixels are pushed out of its own box with
	     object-position, so the box shows only its background, glowing like a
	     Bootstrap .placeholder. No wrapper, so CSS sizing applies to it directly. */
	@media (scripting: enabled) {
		.deferred-img-placeholder { visibility: visible !important; }
		.deferred-img { visibility: hidden; }
		.deferred-img.deferred-img-glow {
			visibility: visible;
			object-position: -100vw 0;
			background-color: currentcolor;
			opacity: .5;
			animation: placeholder-glow 2s ease-in-out infinite;
		}
	}
</style>
<script>
document.addEventListener("DOMContentLoaded", () => {
	const isVideo = (el) => el.tagName === "VIDEO";
	const isReady = (el) => (isVideo(el) ? el.readyState >= 2 /* HAVE_CURRENT_DATA */ : el.complete);

	const whenReady = (el) => isReady(el) ? Promise.resolve() : new Promise((resolve) => {
		el.addEventListener(isVideo(el) ? "loadeddata" : "load", resolve, { once: true });
		el.addEventListener("error", resolve, { once: true });
	});

	const reveal = (els) => els.forEach((el) => {
		el.style.visibility = "visible";
		el.classList.remove("deferred-img-glow");
		el.closest(".placeholder-glow")?.querySelector(".deferred-img-placeholder")?.remove();
	});

	// Media the browser has not started fetching yet: eleventy-img sets
	// loading="lazy" on every <img>, and Chrome likewise defers off-screen
	// autoplay <video>. Neither fires its load event until it nears the
	// viewport, which can be never — on a narrow viewport the post cards stack
	// and everything past the first sits below the fold indefinitely.
	// The margin is deliberately small: every browser starts fetching a lazy
	// image well before it scrolls in (Chrome's threshold is over 1000px), so
	// anything this counts as on-screen is genuinely already in flight.
	const MARGIN = 200;
	// How long a batch waits for its slowest member. An autoplay <video> Chrome
	// has deferred, or a slow remote image, would otherwise hold back everything
	// else on screen. After this, each one reveals as soon as it is ready.
	const BATCH_TIMEOUT = 1000;

	const nearViewport = (el) => {
		const rect = el.getBoundingClientRect();
		const height = window.innerHeight || document.documentElement.clientHeight;
		return rect.top < height + MARGIN && rect.bottom > -MARGIN;
	};

	document.querySelectorAll(".deferred-img-batch").forEach((batch) => {
		const media = Array.from(batch.querySelectorAll(".deferred-img"));

		// Reveal everything that is loading now together, so a visible row of
		// images appears in one go rather than popping in one by one. Anything
		// still deferred is off-screen anyway, so it can wait for itself and
		// reveal on its own once the browser gets round to fetching it.
		const [pending, loading] = media.reduce(
			(acc, el) => (acc[isReady(el) || nearViewport(el) ? 1 : 0].push(el), acc),
			[[], []]
		);

		const deadline = new Promise((resolve) => setTimeout(resolve, BATCH_TIMEOUT));
		Promise.race([Promise.all(loading.map(whenReady)), deadline])
			.then(() => loading.forEach((el) => whenReady(el).then(() => reveal([el]))));
		pending.forEach((el) => whenReady(el).then(() => reveal([el])));
	});
});
</script>
