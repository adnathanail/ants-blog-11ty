<style>
.share-button {
	vertical-align: middle;
}
</style>
<a href="#" class="share-button ms-2 text-primary text-decoration-none" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="Copy link" aria-label="Copy link to this post"><i class="bi bi-share"></i></a>
<script>
document.addEventListener("DOMContentLoaded", () => {
	document.querySelectorAll(".share-button").forEach((link) => {
		const tooltip = new bootstrap.Tooltip(link);
		link.addEventListener("click", async (e) => {
			e.preventDefault();
			await navigator.clipboard.writeText(location.href);
			tooltip.setContent({ ".tooltip-inner": "Copied!" });
			setTimeout(() => tooltip.setContent({ ".tooltip-inner": "Copy link" }), 1500);
		});
	});
});
</script>
