<style>{{ css | safe }}</style>
<script>
document.addEventListener("DOMContentLoaded", () => {
	const heading = document.querySelector("main h1");
	if (!heading) return;

	const link = document.createElement("a");
	link.href = "#";
	link.className = "share-button ms-2";
	link.setAttribute("data-bs-toggle", "tooltip");
	link.setAttribute("data-bs-placement", "top");
	link.setAttribute("data-bs-title", "Copy link");
	link.setAttribute("aria-label", "Copy link to this post");
	link.innerHTML = '<i class="bi bi-share"></i>';
	heading.append(link);

	const tooltip = new bootstrap.Tooltip(link);
	link.addEventListener("click", async (e) => {
		e.preventDefault();
		await navigator.clipboard.writeText(location.href);
		tooltip.setContent({ ".tooltip-inner": "Copied!" });
		setTimeout(() => tooltip.setContent({ ".tooltip-inner": "Copy link" }), 1500);
	});
});
</script>
