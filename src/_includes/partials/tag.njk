{%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
{%- set style = tagStyles[tag] or tagStyles.default %}
{%- set tagClass = "badge text-muted bg-" + style.color + "-subtle border border-" + style.color + " text-capitalize fst-italic" %}
{%- set tagBody %}{% if style.icon %}<i class="bi bi-{{ style.icon }}"></i> {% endif %}{{ tag }}{% endset %}
{%- if noLink %}
<span class="{{ tagClass }}">{{ tagBody | safe }}</span>
{%- else %}
<a href="{{ tagUrl }}" class="{{ tagClass }} text-decoration-none">{{ tagBody | safe }}</a>
{%- endif %}
