{#- `draft` has no tag page; its badge points at the local-only drafts list. -#}
{%- set tagUrl %}{% if tag == "draft" %}/drafts/{% else %}/tags/{{ tag | slugify }}/{% endif %}{% endset %}
{%- set style = tagStyles[tag] %}
{%- set colorClass = "text-bg-" + style.color if style.solid else "text-muted bg-" + style.color + "-subtle border border-" + style.color %}
{%- set tagClass = "badge fst-italic " + colorClass %}
{#- `postCount` is optional: callers that have it (e.g. tags.njk) render as "Coding (5)". -#}
{%- set tagBody %}<i class="bi bi-{{ style.icon }}"></i> {{ style.label }}{% if postCount %} ({{ postCount }}){% endif %}{% endset %}
{%- if noLink %}
<span class="{{ tagClass }}">{{ tagBody | safe }}</span>
{%- else %}
<a href="{{ tagUrl }}" class="{{ tagClass }} text-decoration-none">{{ tagBody | safe }}</a>
{%- endif %}
