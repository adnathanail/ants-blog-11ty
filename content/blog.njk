---js
const pagination = {
	data: "collections.posts",
	size: 10,
	alias: "postslist",
	reverse: true,
};

const eleventyComputed = {
	eleventyNavigation: (data) =>
		data.pagination.pageNumber === 0 ? { key: "Blog", order: 2 } : {},
	permalink: (data) =>
		data.pagination.pageNumber === 0
			? "/blog/"
			: `/blog/page/${data.pagination.pageNumber + 1}/`,
};
---
<h1>Blog</h1>
<p class="text-muted">Things that have captivated me at various points</p>

{% include "postslist.njk" %}

{% if pagination.pages.length > 1 %}
	<p class="text-center mt-3">
		{% if pagination.href.previous %}
			<a href="{{ pagination.href.previous }}"><i class="bi bi-caret-left"></i> Previous</a>
		{% else %}
			<span class="text-muted" aria-disabled="true" tabindex="-1"><i class="bi bi-caret-left"></i> Previous</a>
		{% endif %}

		{% for pageEntry in pagination.pages %}
			{% set pageHref = pagination.hrefs[loop.index0] %}
			{% if loop.index0 === pagination.pageNumber %}
				<span class="mx-2 text-muted text-decoration-underline" aria-current="page">{{ loop.index }}</span>
			{% else %}
				<a href="{{ pageHref }}" class="mx-2">{{ loop.index }}</a>
			{% endif %}
		{% endfor %}

		{% if pagination.href.next %}
			<a href="{{ pagination.href.next }}">Next <i class="bi bi-caret-right"></i></a>
		{% else %}
			<span aria-disabled="true" tabindex="-1" class="text-muted">Next <i class="bi bi-caret-right"></i></a>
		{% endif %}
	</p>
{% endif %}

<a href="/rss.xml" class="btn btn-sm btn-outline-primary mt-3"><i class="bi bi-rss"></i> RSS Feed</a>
