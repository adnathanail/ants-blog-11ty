{
	"name": "ants-blog-11ty",
	"version": "1.0.0",
	"description": "Website for Alex Nathanail Technology Services",
	"type": "module",
	"scripts": {
		"build": "npx @11ty/eleventy",
		"build-dev": "env-cmd -f .env.dev npx @11ty/eleventy",
		"build-nocolor": "cross-env NODE_DISABLE_COLORS=1 npx @11ty/eleventy",
		"start": "env-cmd -f .env.dev npx @11ty/eleventy --serve --quiet",
		"debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
		"debugstart": "env-cmd -f .env.dev cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy",
		"test:visual": "env-cmd -f .env.dev playwright test",
		"test:visual:update": "env-cmd -f .env.dev playwright test --update-snapshots",
		"test:visual:report": "env-cmd -f .env.dev playwright show-report"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/adnathanail/ants-blog-11ty.git"
	},
	"author": {
		"name": "Alex Nathanail",
		"url": "https://adnathanail.dev/"
	},
	"license": "MIT",
	"engines": {
		"node": ">=18"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.6",
		"@11ty/eleventy-img": "^6.0.4",
		"@11ty/eleventy-navigation": "^1.0.5",
		"@11ty/eleventy-plugin-rss": "^3.0.0",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
		"@mdit/plugin-katex": "^1.0.2",
		"@playwright/test": "^1.62.1",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.1",
		"cross-env": "^10.1.0",
		"env-cmd": "^11.0.0",
		"luxon": "^3.7.2",
		"netlify-plugin-cache": "^1.0.3",
		"prismjs": "^1.30.0",
		"sass": "^1.102.0",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@adnathanail/zxcc": "^0.3.4",
		"@zachleat/heading-anchors": "^1.0.5",
		"markdown-it-admonitions": "^0.1.10",
		"markdown-it-attrs": "^5.0.1",
		"markdown-it-footnote": "^4.0.0"
	}
}
